      <li><upToAge>Archotech</upToAge><style>VPHV_HemogenPackCorpse_Pack</style></li>
    </looks>
  </VisualProgression.ItemLooksDef>

  <!-- Vanilla Races Expanded - Sanguophage: sanguophage hemogen pack -->
  <ThingStyleDef MayRequire="vanillaracesexpanded.sanguophage">
    <defName>VPHV_HemogenPackSanguophage_Vial</defName>
    <overrideLabel>hemogen vial (sanguophage)</overrideLabel>
    <graphicData Class="VisualProgression.GraphicData_FromMod">
      <texPath>Item/HemogenPacks/HemogenSanguophagePack</texPath>
      <fromMod>sirvan.hemogentexture</fromMod>
