    </graphicData>
  </ThingStyleDef>

  <ThingStyleDef MayRequire="vanillaracesexpanded.sanguophage">
    <defName>VPHV_HemogenPackSanguophage_Pack</defName>
    <overrideLabel>hemogen pack (sanguophage)</overrideLabel>
    <graphicData Class="VisualProgression.GraphicData_FromMod">
      <texPath>Item/HemogenPacks/HemogenSanguophagePack</texPath>
      <skipMods>
        <li>sirvan.hemogentexture</li>
      </skipMods>
      <drawSize>0.85</drawSize>
    </graphicData>
  </ThingStyleDef>

  <VisualProgression.ItemLooksDef MayRequire="vanillaracesexpanded.sanguophage">
    <defName>VPHV_HemogenPackSanguophage</defName>
    <item>VRE_HemogenPack_Sanguophage</item>
    <looks>
      <li><upToAge>Medieval</upToAge><style>VPHV_HemogenPackSanguophage_Vial</style></li>
      <li><upToAge>Archotech</upToAge><style>VPHV_HemogenPackSanguophage_Pack</style></li>
